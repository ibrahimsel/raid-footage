{
  "Recorder": {
    "CameraId": "cam12",
    "OutputDirectory": "recordings",
    "Fps": 10,
    "RenderScale": 2,
    "SampleLifetimeSeconds": 3,
    "SegmentMinutes": 15,
    "FfmpegPath": "ffmpeg",
    "EncoderThreads": 2,
    "Crf": 18,
    "FrameTimeoutSeconds": 30,
    "RequestTimeoutSeconds": 15,
    "WriteTimeoutSeconds": 10,
    "FinalizeTimeoutSeconds": 30,
    "MaxLagSeconds": 5,
    "ReconnectMaxSeconds": 60,
    "SnapshotSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
